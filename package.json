{
  "name": "vui-hoc-toan-5",
  "version": "0.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "assets:generate": "node scripts/generate-asset-catalog.cjs",
    "assets:optimize": "npm run assets:generate && node scripts/optimize-previews.cjs && npm run assets:generate",
    "prestart": "npm run assets:optimize",
    "prebuild": "npm run assets:optimize",
    "assets:verify": "node scripts/verify-asset-catalog.cjs",
    "test:cache": "ng test --configuration cache --watch=false --browsers=ChromeHeadless --include=src/app/services/read-cache.service.spec.ts",
    "test:performance": "ng test --configuration cache --watch=false --browsers=ChromeHeadless --include=src/app/services/*.spec.ts --include=src/app/components/document-page/*.spec.ts --include=src/app/components/flip-book/*.spec.ts --include=src/app/teacher-library/*.spec.ts",
    "test:smoke": "node scripts/browser-smoke.cjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.1.0",
    "@angular/cdk": "^18.1.1",
    "@angular/common": "^18.1.0",
    "@angular/compiler": "^18.1.0",
    "@angular/core": "^18.1.0",
    "@angular/fire": "^18.0.1",
    "@angular/forms": "^18.1.0",
    "@angular/platform-browser": "^18.1.0",
    "@angular/platform-browser-dynamic": "^18.1.0",
    "@angular/platform-server": "^18.1.0",
    "@angular/router": "^18.1.0",
    "@angular/ssr": "^18.1.0",
    "bootstrap": "^5.3.3",
    "express": "^4.18.2",
    "firebase": "^10.14.1",
    "html2pdf.js": "^0.10.3",
    "konva": "^9.3.14",
    "ng2-pdf-viewer": "^10.2.2",
    "rxjs": "~7.8.0",
    "three": "^0.177.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.1.0",
    "@angular/cli": "^18.1.0",
    "@angular/compiler-cli": "^18.1.0",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "@types/three": "^0.177.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "sharp": "^0.35.5",
    "typescript": "~5.5.2"
  }
